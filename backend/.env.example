PORT=8080
NODE_ENV=development

# Required for database/authentication. Never commit the real values.
DATABASE_URL=
JWT_SECRET=

# Code execution service URL.
JUDGE0_API_URL=http://localhost:2358

# Optional. Enables Gemini research with Google Search grounding.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=60000
